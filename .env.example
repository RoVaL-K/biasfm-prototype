PORT=3000
# Must match your Spotify application's registered callback origin.
APP_ORIGIN=http://127.0.0.1:3000
# Required for Last.fm imports and live tag charts:
LASTFM_API_KEY=
# Required for Last.fm account linking and signed auth.getSession calls.
# Keep this value server-side; never expose it in frontend code.
LASTFM_API_SECRET=
# Public client identifier; Authorization Code + PKCE does not require a client secret.
SPOTIFY_CLIENT_ID=
# OAuth login providers. Register both callback URLs before adding these values
# to Cloudflare Pages secrets (never commit client secrets).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# At least 24 random characters; never expose in frontend code or commit to Git.
EDITORIAL_TOKEN=
# Persistent directory, required as a mounted volume in hosted deployments:
DATA_DIR=.data
# Public operator information (complete before publishing):
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
